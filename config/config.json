{
  "workflowApiVersion": "1.1",
  "metaData": {
    "icon": "https://diywebhook.onrender.com/ui/icon.png",
    "category": "message",
    "isConfigured": true
  },
  "type": "REST",
  "lang": {
    "en-US": {
      "name": "Webhook Sender",
      "description": "Sends contact journey data to an external webhook or API endpoint."
    }
  },
  "arguments": {
    "execute": {
      "inArguments": [
        { "contactKey":   "{{Contact.Key}}" },
        { "emailAddress": "{{InteractionDefaults.Email}}" },
        { "firstName":    "{{Contact.Attribute.ExactTargetSubscriberContext_def.FirstName}}" },
        { "lastName":     "{{Contact.Attribute.ExactTargetSubscriberContext_def.LastName}}" },
        { "journeyName":  "{{Interaction.Name}}" },
        { "activityName": "{{Activity.Name}}" }
      ],
      "outArguments": [],
      "url": "https://diywebhook.onrender.com/execute",
      "verb": "POST",
      "body": "",
      "header": "",
      "format": "json",
      "useJwt": true,
      "timeout": 10000
    }
  },
  "configurationArguments": {
    "save": {
      "url": "https://diywebhook.onrender.com/save",
      "verb": "POST",
      "useJwt": true
    },
    "publish": {
      "url": "https://diywebhook.onrender.com/publish",
      "verb": "POST",
      "useJwt": true
    },
    "validate": {
      "url": "https://diywebhook.onrender.com/validate",
      "verb": "POST",
      "useJwt": true
    },
    "stop": {
      "url": "https://diywebhook.onrender.com/stop",
      "verb": "POST",
      "useJwt": true
    }
  },
  "userInterfaces": {
    "configModal": {
      "url": "https://diywebhook.onrender.com/ui/index.html",
      "height": 500,
      "width": 600
    }
  },
  "schema": {
    "arguments": {
      "execute": {
        "inArguments": [
          { "contactKey":   { "dataType": "Text", "isNullable": false, "direction": "in" } },
          { "emailAddress": { "dataType": "EmailAddress", "isNullable": true,  "direction": "in" } },
          { "firstName":    { "dataType": "Text", "isNullable": true,  "direction": "in" } },
          { "lastName":     { "dataType": "Text", "isNullable": true,  "direction": "in" } },
          { "journeyName":  { "dataType": "Text", "isNullable": true,  "direction": "in" } },
          { "activityName": { "dataType": "Text", "isNullable": true,  "direction": "in" } }
        ]
      }
    }
  }
}
